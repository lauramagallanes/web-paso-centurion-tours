package com.tinambu.tours.controller;

import com.tinambu.tours.dto.response.ApiResponse;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.math.BigDecimal;
import java.time.LocalDateTime;
import java.util.Arrays;
import java.util.List;
import java.util.Map;
import java.util.UUID;

/**
 * Controlador de prueba para senderos sin dependencias de BD
 */
@RestController
@RequestMapping("/senderos")
@CrossOrigin(origins = {"*"})
public class TestSenderoController {

    /**
     * Obtener senderos activos - datos hardcodeados para pruebas
     */
    @GetMapping
    public ResponseEntity<ApiResponse<List<Object>>> obtenerSenderosActivos() {
        try {
            List<Object> senderos = Arrays.asList(
                Map.of(
                    "id", UUID.randomUUID().toString(),
                    "nombre", "Sendero de Prueba 1",
                    "descripcion", "Un sendero hermoso para caminar",
                    "duracionHoras", 3,
                    "nivelDificultad", "FACIL",
                    "precioPorPersona", 25.00,
                    "capacidadMaximaGrupo", 8,
                    "activo", true
                ),
                Map.of(
                    "id", UUID.randomUUID().toString(),
                    "nombre", "Sendero de Prueba 2", 
                    "descripcion", "Sendero avanzado con vistas espectaculares",
                    "duracionHoras", 5,
                    "nivelDificultad", "DIFICIL",
                    "precioPorPersona", 45.00,
                    "capacidadMaximaGrupo", 6,
                    "activo", true
                )
            );
            return ResponseEntity.ok(ApiResponse.success(senderos));
        } catch (Exception e) {
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
                .body(ApiResponse.error("Error al obtener senderos"));
        }
    }

    /**
     * Obtener todos los senderos (admin) - datos hardcodeados
     */
    @GetMapping("/admin")
    public ResponseEntity<ApiResponse<List<Object>>> obtenerTodosLosSenderos() {
        try {
            List<Object> senderos = Arrays.asList(
                Map.of(
                    "id", UUID.randomUUID().toString(),
                    "nombre", "Sendero Activo 1",
                    "descripcion", "Sendero disponible para reservas",
                    "duracionHoras", 4,
                    "nivelDificultad", "INTERMEDIO",
                    "precioPorPersona", 35.00,
                    "capacidadMaximaGrupo", 10,
                    "activo", true,
                    "fechaCreacion", LocalDateTime.now().toString()
                ),
                Map.of(
                    "id", UUID.randomUUID().toString(),
                    "nombre", "Sendero Inactivo 1",
                    "descripcion", "Sendero temporalmente cerrado",
                    "duracionHoras", 2,
                    "nivelDificultad", "FACIL",
                    "precioPorPersona", 20.00,
                    "capacidadMaximaGrupo", 12,
                    "activo", false,
                    "fechaCreacion", LocalDateTime.now().minusDays(30).toString()
                )
            );
            return ResponseEntity.ok(ApiResponse.success(senderos));
        } catch (Exception e) {
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
                .body(ApiResponse.error("Error al obtener senderos"));
        }
    }

    /**
     * Crear nuevo sendero (admin) - simulación sin persistencia
     */
    @PostMapping("/admin")
    public ResponseEntity<ApiResponse<Object>> crearSendero(@RequestBody Object sendero) {
        try {
            // Simular creación exitosa
            Object nuevoSendero = Map.of(
                "id", UUID.randomUUID().toString(),
                "nombre", "Sendero Creado por API",
                "descripcion", "Sendero creado exitosamente via API",
                "duracionHoras", 3,
                "nivelDificultad", "INTERMEDIO",
                "precioPorPersona", 30.00,
                "capacidadMaximaGrupo", 8,
                "activo", true,
                "fechaCreacion", LocalDateTime.now().toString()
            );
            
            return ResponseEntity.status(HttpStatus.CREATED)
                .body(ApiResponse.success(nuevoSendero));
        } catch (Exception e) {
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
                .body(ApiResponse.error("Error al crear sendero"));
        }
    }

    /**
     * Endpoint de prueba para verificar que el backend funciona
     */
    @GetMapping("/test")
    public ResponseEntity<ApiResponse<Void>> test() {
        return ResponseEntity.ok(ApiResponse.success("Backend funcionando correctamente!"));
    }
}
