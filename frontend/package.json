{
  "name": "web-paso-centruion-tours",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run src/test/integration/",
    "test:integration:backend": "vitest run src/test/integration/BackendConnectivity.test.tsx",
    "test:integration:hooks": "vitest run src/test/integration/ApiHooks.simple.test.tsx",
    "test:integration:full": "vitest run src/test/integration/FullAppIntegration.test.tsx",
    "test:integration:real": "vitest run src/test/integration/RealBackendConnectivity.test.tsx",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test:run && npm run test:integration",
    "test:all:real": "npm run test:run && npm run test:integration && npm run test:integration:real"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "axios": "^1.7.9",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.13.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.544.0",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.6",
    "react-datepicker": "^9.1.0",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^24.1.0",
    "@types/react": "^18.3.10",
    "@types/react-datepicker": "^7.0.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.6.1",
    "eslint": "^9.11.1",
