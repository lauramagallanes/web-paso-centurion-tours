    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "jsdom": "^23.2.0",
    "msw": "^2.10.4",
    "typescript": "^5.8.3",
    "vite": "^5.4.8",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^1.6.1"
  }
