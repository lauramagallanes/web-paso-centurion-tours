# Configuración OPTIMIZADA PARA COSTOS MÍNIMOS
# Paso Centurión Tours - Solo lo esencial

# AWS Configuration
aws_region  = "us-east-1"
environment = "production"
project_name = "paso-centurion-tours"

# Infraestructura existente - ACTUALIZAR CON TUS VALORES
existing_ec2_instance_id = "i-1234567890abcdef0"  # Tu instancia EC2
existing_elastic_ip = "54.123.456.789"            # Tu IP elástica
existing_s3_bucket_name = "pasocenturion-images"  # Tu bucket S3
existing_s3_bucket_domain = "pasocenturion-images.s3.amazonaws.com"

# Dominio (OPCIONAL - dejar vacío si no quieres usar dominio custom)
domain_name = ""  # "pasocenturion.com.uy" o "" para no usar
existing_hosted_zone_id = ""  # Solo si ya tienes hosted zone

# OPCIONES DE COSTO - Configurar según necesidad

# VPC: Solo crear si necesitas aislamiento de red (COSTO ADICIONAL)
create_vpc = false  # true = crear VPC nueva, false = usar default VPC

# CloudFront: RECOMENDADO - Gratis hasta 1TB/mes + protección DDoS
enable_cloudfront = true

# SSL: Solo si tienes dominio custom
enable_ssl = false  # true solo si domain_name no está vacío

# Base de datos: Solo en producción, usar SQLite local para desarrollo
create_database = false  # true = RDS PostgreSQL (~$13/mes), false = usar SQLite

# Monitoreo básico: Gratis hasta cierto límite
enable_basic_monitoring = true

# Acceso directo al EC2 (sin CloudFront)
enable_direct_http = true   # Permitir HTTP directo
enable_direct_https = false # Solo si tienes SSL configurado en EC2

# Configuración de red (solo si create_vpc = true)
vpc_cidr = "10.0.0.0/16"
public_subnet_cidrs = ["10.0.1.0/24"]  # Solo una subnet

# SEGURIDAD: Cambiar por tu IP específica
allowed_ssh_cidrs = ["TU_IP_PUBLICA/32"]  # Ejemplo: ["201.222.123.45/32"]

# Base de datos (solo si create_database = true)
db_name = "pasocenturiondb"
db_username = "dbadmin"
db_password = ""  # Dejar vacío si no usas DB

# ========================================
# CONFIGURACIONES RECOMENDADAS POR COSTO:
# ========================================

# GRATIS (Free Tier):
# - CloudFront (hasta 1TB/mes)
# - Certificate Manager SSL
# - Security Groups mejorados
# - CloudWatch básico
# - S3 optimizations
# COSTO: $0/mes

# MÍNIMO (~$0-3/mes):
# - Solo CloudFront + SSL + Security Groups
# - Sin VPC, sin ALB, sin NAT Gateway
# - Base de datos SQLite local
# COSTO: $0-3/mes

# BÁSICO (~$13/mes):
# - CloudFront + SSL + Security Groups
# - RDS PostgreSQL db.t3.micro
# - Sin VPC, sin ALB, sin NAT Gateway
# COSTO: ~$13/mes

# COMPLETO (~$60/mes):
# - Todo lo anterior + VPC + ALB + NAT Gateway
# COSTO: ~$60/mes
