# Example Terraform variables file for Paso Centurión Tours
# Copy this file to terraform.tfvars and update the values

# AWS Configuration
aws_region  = "us-east-1"
environment = "production"

# Project Configuration
project_name = "paso-centurion-tours"

# Network Configuration
vpc_cidr                = "10.0.0.0/16"
public_subnet_cidrs     = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs    = ["10.0.10.0/24", "10.0.20.0/24"]
allowed_ssh_cidrs       = ["YOUR_IP_ADDRESS/32"]  # Replace with your IP

# EC2 Configuration
instance_type      = "t3.micro"      # Free tier eligible
root_volume_size   = 20              # GB

# SSH Key - Add your public key here
public_key = "ssh-rsa  laura@laura"

# Database Configuration
create_database             = true
db_instance_class          = "db.t3.micro"  # Free tier eligible
db_allocated_storage       = 20             # GB
db_max_allocated_storage   = 100            # GB
postgres_version           = "15.4"
db_name                    = "pasocenturiondb"
db_username                = "dbadmin"
db_password                = "CHANGE_THIS_SECURE_PASSWORD_123!"  # Use a strong password
db_backup_retention_period = 7
db_backup_window          = "03:00-04:00"
db_maintenance_window     = "sun:04:00-sun:05:00"

# Optional: Domain and SSL
# domain_name         = "pasocenturion.com"
# ssl_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/12345678-1234-1234-1234-123456789012"

# Monitoring
enable_monitoring    = true
log_retention_days   = 30
